// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  avatarUrl    String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedSpaces  Space[]    @relation("SpaceOwner")
  reported     WorkItem[] @relation("WorkItemReporter")
}

model Space {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique
  counter   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User       @relation("SpaceOwner", fields: [ownerId], references: [id])
  workItems WorkItem[]
  template  String   @default("kanban")  // just the template id
}

model WorkItem {
  id          String   @id @default(uuid())
  key         String   @unique
  summary     String
  description String?
  workType    WorkType
  status      Status   @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spaceId    String
  space      Space @relation(fields: [spaceId], references: [id])
  reporterId String
  reporter   User  @relation("WorkItemReporter", fields: [reporterId], references: [id])
}

enum WorkType {
  TASK
  BUG
  EPIC
  STORY
}

enum Status {
  OPEN
  IN_PROGRESS
  DONE
}